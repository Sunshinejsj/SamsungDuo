    <string name="tab_general">常规</string>

    <string name="master_title">启用三合一图标</string>
    <string name="master_summary">总开关。关闭后隐藏本模块额外绘制的三合一图标；系统原机图标不受影响。</string>

    <string name="trio_style_title">三合一样式</string>
    <string name="trio_style_summary">选择三合一的排布方式。圆环是默认样式；矩形改用左右两列信号点夹住中间内容，底部横贯一条电量条；胶囊把外壳轮廓本身当作电量条，左列固定显示时间，右侧一格按「充电→Wi-Fi→电量→网络制式」的优先级显示一个读数，信号点骑在轮廓上下两条边上。</string>
    <string name="trio_style_ring">圆环</string>
    <string name="trio_style_rect">矩形</string>
    <string name="trio_style_capsule">胶囊</string>



    <string name="overlay_title">解除尺寸限制</string>
    <string name="overlay_summary">开启后解除 100% 尺寸上限，三合一图标可调到 130%，关闭时最大 100%。</string>

    <string name="show_wifi_title">显示 Wi-Fi 弧</string>
    <string name="show_wifi_summary">在圈内显示 Wi-Fi 弧线，弧数跟随实际信号强度；关闭后不显示。</string>

    <string name="show_mobile_title">显示移动信号点</string>
    <string name="show_mobile_summary">在底部显示四个电平点表示移动网络信号强度；关闭后不显示。</string>

    <string name="dual_sim_title">双卡信号</string>
    <string name="dual_sim_summary">无 Wi-Fi 且未充电时，显示上下两排信号点：上排为卡一，下排为卡二。只在双卡时生效；单卡或正在充电时仍只显示一排，显示当前上网卡。</string>

    <string name="show_value_title">显示电量数字</string>
    <string name="show_value_summary">在环内显示电量百分比；充电时改为闪电图标。关闭后不显示。</string>

    <string name="show_bolt_title">充电时显示闪电</string>
    <string name="show_bolt_summary">关闭后不再用环内闪电图标</string>

    <string name="show_mobile_type_title">网络类型</string>
    <string name="show_mobile_type_summary">选择网络类型文字的显示位置：关闭、圆环内、圆环外额外绘制。</string>
    <string name="mobile_type_off">关闭</string>
    <string name="mobile_type_inside">环内</string>
    <string name="mobile_type_outside">环外</string>

    <string name="signal_mode_title">信号位置</string>
    <string name="signal_mode_summary">选择移动信号读数的显示位置。底部圆环修改为圆点显示、圆环外额外绘制。</string>
    <string name="signal_mode_inside">环内</string>
    <string name="signal_mode_outside">环外</string>

    <string name="stacked_signal_title">堆叠信号</string>
    <string name="stacked_signal_summary">环外时显示样式开关：开启为双卡堆叠显示，关闭为双卡分别显示。</string>

    <string name="data_sim_only_title">仅显示上网卡</string>
    <string name="data_sim_only_summary">双卡时只显示当前上网卡的读数，另一张卡不显示。单卡或读不到上网卡时不受影响。</string>

    <string name="out_signal_size_title">环外信号大小</string>
    <string name="out_signal_size_summary">环外读数的整体高度。默认值15dp；可调范围 6–20dp。</string>

    <string name="out_signal_margin_title">环外信号间距</string>
    <string name="out_signal_margin_summary">环外信号与电池图标之间的空隙。默认 2dp，可调范围 0–16dp。</string>

    <string name="glyph_shift_title">整组左右平移</string>
    <string name="glyph_shift_summary">整体左右移动三合一图标。0 = 默认位置；可调整三合一图标的右边距。</string>
    <string name="charge_pair_title">充电时同时显示电量</string>
    <string name="charge_pair_summary">充电时把电量数字和闪电并排显示。隐藏时保持默认；圈上时放在充电缺口；圈内时放在圆环中间。</string>
    <string name="charge_signal_title">充电时同时显示信号</string>
    <string name="charge_signal_summary">开启时信号图示也放到充电缺口和闪电并排显示；关闭时信号隐藏。需要开启「电量数字居中」。</string>
    <string name="charge_pair_off">隐藏</string>
    <string name="charge_pair_gap">圈上</string>
    <string name="charge_pair_centre">圈内</string>
    <string name="charge_value_size_title">闪电与电量大小</string>
    <string name="charge_value_size_summary">调整"闪电＋电量"的大小，默认 30，可调范围 30–35。</string>
    <string name="charge_signal_size_title">闪电与信号大小</string>
    <string name="charge_signal_size_summary">调整"闪电＋信号"的大小，默认 30，可调范围 30–35。</string>
    <string name="charge_suffix_a_title">组合图标中 A 的大小</string>
    <string name="charge_suffix_a_summary">只在组合图标里显示 5GA 时生效，调整尾部 "A" 相对主字号的百分比。默认 65%，可调范围 50–100%。</string>
    <string name="group_charge_pair">充电组合图标</string>
    <!-- ★ 胶囊三按钮显式控制（2026-10-21 用户拍板）。仅胶囊样式显示。 -->
    <string name="group_capsule_buttons">胶囊内容控制</string>
    <!-- 文案精简（2026-10-22 用户定稿）：去掉「按钮N：」前缀，标题=短名，摘要=一句说明。 -->
    <string name="capsule_right_title">右侧默认显示组件</string>
    <string name="capsule_right_summary">电量 或 信号。</string>
    <string name="capsule_right_value">电量</string>
    <string name="capsule_right_signal">信号</string>
    <string name="capsule_gap_title">顶部缺口组件</string>
    <string name="capsule_gap_summary">选「闪电」只有充电才显示。</string>
    <string name="capsule_gap_none">隐藏</string>
    <string name="capsule_gap_bolt">闪电</string>
    <string name="capsule_gap_value">电量</string>
    <string name="capsule_gap_signal">信号</string>
    <string name="capsule_bolt_pos_title">充电时闪电位置</string>
    <string name="capsule_bolt_pos_summary">隐藏，圈上，圈内。</string>
    <string name="capsule_bolt_hidden">隐藏</string>
    <string name="capsule_bolt_gap">圈上</string>
    <string name="capsule_bolt_gap_pair">圈上+同伴</string>
    <string name="capsule_bolt_centre_pair">右侧+同伴</string>
    <string name="capsule_shape_title">胶囊形状</string>
    <string name="capsule_shape_summary">三星风格圆角更方（匹配 S25U）。</string>
    <string name="capsule_shape_normal">常规</string>
    <string name="capsule_shape_samsung">三星风格</string>
    <string name="capsule_length_title">胶囊长度</string>
    <string name="capsule_length_summary">默认0可调-30到60，加长直线段，圆角与角度不变。</string>
    <string name="glyph_left_offset_title">整组左侧间距</string>
    <string name="glyph_left_offset_summary">调整原生状态栏到三合一图标的距离。默认 0，可调范围 -8.0～+8.0dp。</string>

    <string name="burn_in_protect_title">图标微动</string>
    <string name="burn_in_protect_summary">让三合一与环外图标在极小范围内缓慢游走，避免同一批像素长期发光留下残影。默认开启。</string>
    <string name="burn_in_amplitude_title">微动幅度</string>
    <string name="burn_in_amplitude_summary">图标偏离原位的最大距离，每格 0.25dp。默认 0.50dp；调到 0 完全不动。幅度越大保护越彻底，限制不超过 2dp 。</string>
    <string name="burn_in_period_title">微动周期</string>
    <string name="burn_in_period_summary">走完一个完整周期所需的秒数，默认 60 秒。周期越短移动越快。</string>

    <string name="glyph_scale_title">三合一图标尺寸</string>
    <string name="glyph_scale_summary" formatted="false">整个三合一图标大小调整，可调范围 60–130%，默认 100% ，超过 100% 时图形与占位一起放大、高度大于状态栏其它图标，不会遮挡原生图标。</string>
    <string name="glyph_scale_summary_capped" formatted="false">整个三合一图标大小调整，可调范围 60–100%，默认 100% ，想要突破 100% 大小限制，请先打开「解除尺寸限制」开关。</string>

    <string name="perf_temp_title">电池温度</string>
    <string name="perf_temp_summary">在电池图标旁显示电池温度。</string>
    <string name="perf_outer_margin_title">温度读数边距</string>
    <string name="perf_outer_margin_summary" formatted="false">温度读数与左侧邻居之间的空隙。默认 2dp，可调范围 0–16dp。</string>
    <string name="perf_outer_margin_right_title">温度读数右边距</string>
    <string name="perf_outer_margin_right_summary" formatted="false">温度读数与右侧三合一之间的空隙。默认 2dp，可调范围 0–16dp。</string>
    <string name="perf_scale_title">读数整体尺寸</string>
    <string name="perf_scale_summary" formatted="false">在自动字号之上再把读数整体放大或缩小，百分比 60–150%，默认 100%。</string>
    <string name="perf_weight_title">读数字重</string>
    <string name="perf_weight_summary">读数文字的笔画粗细，可调范围100-900。</string>

    <string name="value_centre_title">电量数字居中</string>
    <string name="value_centre_summary">电量数字放大到圆环中间并始终优先占据圆心。Wi-Fi 弧缩到顶部缺口，充电时改用小的闪电占用缺口。</string>

    <string name="color_role_title">状态颜色</string>
    <string name="color_role_summary">分别为低电量、充电与危险电量指定颜色。</string>

    <string name="color_low_title">低电量颜色</string>
    <string name="color_charging_title">充电颜色</string>
    <string name="color_critical_title">危险电量颜色</string>
    <string name="color_field_summary">点按选择颜色</string>
    <string name="color_on_dark">深色背景</string>
    <string name="color_on_light">浅色背景</string>
    <string name="color_dialog_summary">分别设置状态栏为深色与浅色背景时使用的颜色。</string>
    <string name="color_reset">恢复默认</string>
    <string name="color_reset_summary">把三种状态颜色恢复为出厂预设。</string>
    <string name="color_reset_dialog_summary">三种状态颜色都会回到出厂预设，当前的自定义颜色会被覆盖。</string>
    <string name="color_reset_confirm">恢复</string>

    <string name="low_threshold_title">低电量阈值</string>
    <string name="power_save_color_title">省电模式变色</string>
    <string name="power_save_color_summary" formatted="false">开启后，系统进入省电模式时电量环会变成低电量的黄色。关闭后三合一电量颜色保持不变。默认开启。</string>
    <string name="low_threshold_summary">电量低于该值时切换到低电量颜色。</string>

    <string name="stroke_title">环线粗细</string>
    <string name="stroke_summary">电池圆环的描边宽度。</string>
    <string name="stroke_title_rect">电量条粗细</string>
    <string name="stroke_summary_rect">底部电量条的厚度。</string>

    <string name="arc_stroke_title">弧线粗细</string>
    <string name="arc_stroke_summary">Wi-Fi 弧线的描边宽度。</string>
    <string name="arc_stroke_summary_rect">Wi-Fi 弧线的描边宽度。</string>

    <string name="value_size_title">数字字号</string>
    <string name="value_size_summary">电量百分比文字的尺寸。注意「电量数字居中」打开时，居中的数字最大放大到原值的 1.4 倍，38 及以上不再变大。</string>

    <string name="value_weight_title">数字字重</string>
    <string name="value_weight_summary">电量数字的笔画粗细，可调范围100-900。</string>

    <string name="type_size_title">网络类型字号</string>
    <string name="type_size_summary">圆环中间 3G/4G/5G 等文字的大小。</string>

    <string name="out_type_size_title">环外网络类型字号</string>
    <string name="out_type_size_summary">状态栏中环外 3G/4G/5G 等文字的大小，默认 14dp，可调范围 8–26dp。</string>

    <string name="out_type_margin_left_title">环外类型左边距</string>
    <string name="out_type_margin_left_summary">环外信号读数与 5G 类型标签之间的空隙。默认 2dp，可调范围 0–16dp。</string>

    <string name="out_type_margin_right_title">环外类型右边距</string>
    <string name="out_type_margin_right_summary">5G 类型标签与右侧图标之间的空隙。默认 2dp，可调范围 0–16dp。</string>

    <string name="type_suffix_scale_title">5GA 中 A 的比例</string>
    <string name="type_suffix_scale_summary">网络类型以 A 结尾时（如 5GA），末尾的 A 相对主字号的百分比。默认 65%，可调范围 50–100%；环内与环外两处同时生效。</string>

    <string name="type_weight_title">网络类型字重</string>
    <string name="type_weight_summary">网络类型的笔画粗细，可调范围100-900。</string>

    <string name="track_alpha_title">底纹浓度</string>
    <string name="track_alpha_summary">未点亮部分的透明度。</string>

    <string name="debug_title">调试日志</string>
    <string name="debug_summary">把详细过程写入 /sdcard/SamsungDuo_debug.log，排查问题时开启。</string>

